  "security": [
    {
      "id": "CWE-22",
      "title": "Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')",
      "category": "File & Path Security",
      "severity": "optional",
      "description": "The product uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the product does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory.",
      "evidence": {
        "files": [
          "src/Contoso.LegacyBank.Batch/BatchSettings.cs:30"
        ],
        "explanation": "BatchSettings.Load combines the configured InputDirectoryName with RootDirectory at line 30 without validating that the resolved path remains beneath the configured root."
      },
      "storyPoint": 8
    },
    {
      "id": "CWE-23",
      "title": "Relative Path Traversal",
      "category": "File & Path Security",
      "severity": "optional",
      "description": "The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize sequences such as .. that can resolve to a location that is outside of that directory.",
      "evidence": {
        "files": [
          "src/Contoso.LegacyBank.Batch/BatchSettings.cs:30"
        ],
        "explanation": "BatchSettings.Load accepts a configured directory name containing relative traversal segments when constructing InputDirectory at line 30."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-36",
      "title": "Absolute Path Traversal",
      "category": "File & Path Security",
      "severity": "optional",
      "description": "The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize absolute path sequences such as /abs/path that can resolve to a location that is outside of that directory.",
      "evidence": {
        "files": [
          "src/Contoso.LegacyBank.Batch/BatchSettings.cs:30"
        ],
        "explanation": "BatchSettings.Load passes a configured directory name directly to Path.Combine at line 30, allowing a rooted path to replace the configured root."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-99",
      "title": "Improper Control of Resource Identifiers ('Resource Injection')",
      "category": "Injection Attacks",
      "severity": "potential",
      "description": "The product receives input from an upstream component, but it does not restrict or incorrectly restricts the input before it is used as an identifier for a resource that may be outside the intended sphere of control.",
      "evidence": {
        "files": [
          "src/Contoso.LegacyBank.Batch/BatchSettings.cs:34"
        ],
        "explanation": "BatchSettings.Load constructs the WCF AccountServiceEndpoint URI from an unrestricted application configuration value at line 34."
